# ─────────────────────────────────────────────────────────────────────────────
# Dockerfile.gpu — Worker de simulaciones Celery con Monte Carlo acelerado por GPU
# ─────────────────────────────────────────────────────────────────────────────
# OPCIONAL. Imagen para correr el worker de la cola `simulations` sobre una GPU
# NVIDIA (p. ej. la RTX 5070 Ti del host Linux). El resto del stack (web, beat,
# worker `default`) sigue usando el `Dockerfile` CPU normal.
#
# No usa imagen base `nvidia/cuda`: los wheels pip `nvidia-cuda-*-cu12` (en
# requirements/gpu.txt) traen el runtime + NVRTC de CUDA. Solo se necesita el
# driver del host, expuesto con nvidia-container-toolkit (`--gpus all`).
#
# Build:  docker build -f Dockerfile.gpu -t kapitalya/findemproai-gpu:vYYYYMMDD .
# Run:    docker run --gpus all -e FINDEMPRO_GPU=on ... kapitalya/findemproai-gpu:...

FROM python:3.12-slim-bookworm AS builder

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential libpq-dev pkg-config \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build
COPY requirements/base.txt requirements/base.txt
COPY requirements/production.txt requirements/production.txt
COPY requirements/gpu.txt requirements/gpu.txt

RUN pip install --user --no-cache-dir -r requirements/gpu.txt

# ─────────────────────────────────────────────────────────────────────────────
FROM python:3.12-slim-bookworm AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    DJANGO_ENV=production \
    DJANGO_SETTINGS_MODULE=findempro.settings.production \
    PATH="/home/appuser/.local/bin:$PATH" \
    FINDEMPRO_GPU=auto \
    FINDEMPRO_MC_ENGINE=vectorized \
    # NVRTC/runtime de CUDA provistos por los wheels pip de NVIDIA:
    LD_LIBRARY_PATH="/home/appuser/.local/lib/python3.12/site-packages/nvidia/cuda_nvrtc/lib:/home/appuser/.local/lib/python3.12/site-packages/nvidia/cuda_runtime/lib"

RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 netcat-openbsd postgresql-client curl \
    && rm -rf /var/lib/apt/lists/*

RUN useradd -m -u 1000 -s /bin/bash appuser

WORKDIR /app
COPY --from=builder /root/.local /home/appuser/.local
COPY --chown=appuser:appuser . .

RUN mkdir -p /app/staticfiles /app/media /app/media/chart_images /app/logs \
    && chown -R appuser:appuser /app /home/appuser/.local

USER appuser

# Verifica en build-time que CuPy importa (no que haya GPU — eso es en runtime).
RUN python -c "import cupy; print('cupy', cupy.__version__, 'OK')"

# Worker dedicado a la cola de simulaciones (donde vive el Monte Carlo pesado).
CMD ["celery", "-A", "findempro", "worker", "--loglevel=info", \
     "--concurrency=1", "-Q", "simulations", "-n", "gpu-worker@%h"]
