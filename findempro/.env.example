# ══════════════════════════════════════════════════════════════
# FINDEMPRO — Variables de entorno
# Copiar a .env y completar con valores reales.
# NUNCA commitear .env con valores reales.
# ══════════════════════════════════════════════════════════════

# ──────────────────────────────────────────────────────────────
# Entorno activo
# Valores: development | staging | production
# ──────────────────────────────────────────────────────────────
DJANGO_ENV=production

# ──────────────────────────────────────────────────────────────
# Seguridad Django
# Generar con: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# ──────────────────────────────────────────────────────────────
SECRET_KEY=cambia-esto-con-una-clave-aleatoria-larga-y-segura

# Hosts permitidos (separados por coma)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,tu-dominio.com,www.tu-dominio.com

# Habilitar DEBUG solo en desarrollo
DEBUG=False

# ──────────────────────────────────────────────────────────────
# Base de datos PostgreSQL
# ──────────────────────────────────────────────────────────────
DB_ENGINE=django.db.backends.postgresql
DB_NAME=findempro
DB_USER=findempro
DB_PASSWORD=password-seguro-aqui
DB_HOST=db
DB_PORT=5432
DB_CONN_MAX_AGE=600

# ──────────────────────────────────────────────────────────────
# Redis
# ──────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/1
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# ──────────────────────────────────────────────────────────────
# HTTPS / SSL
# Cambiar a true cuando tengas certificado SSL configurado
# ──────────────────────────────────────────────────────────────
HTTPS_ENABLED=false

# ──────────────────────────────────────────────────────────────
# CORS — Orígenes permitidos (separados por coma)
# Para frontend separado: https://app.tu-dominio.com
# ──────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# CSRF Trusted Origins (necesario para Django 4.x+)
CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1,https://tu-dominio.com

# ──────────────────────────────────────────────────────────────
# Email SMTP
# ──────────────────────────────────────────────────────────────
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=tu-email@gmail.com
EMAIL_HOST_PASSWORD=tu-app-password-de-gmail
DEFAULT_FROM_EMAIL=FINDEMPRO <no-reply@tu-dominio.com>

# ──────────────────────────────────────────────────────────────
# Google OAuth2
# Crear en: https://console.cloud.google.com/
# ──────────────────────────────────────────────────────────────
SOCIAL_AUTH_GOOGLE_OAUTH2_KEY=tu-client-id.apps.googleusercontent.com
SOCIAL_AUTH_GOOGLE_OAUTH2_SECRET=tu-client-secret

# ──────────────────────────────────────────────────────────────
# Django Sites Framework
# ──────────────────────────────────────────────────────────────
SITE_ID=1

# ──────────────────────────────────────────────────────────────
# Superusuario inicial (creado automáticamente al iniciar)
# ──────────────────────────────────────────────────────────────
DJANGO_SUPERUSER_EMAIL=admin@tu-dominio.com
DJANGO_SUPERUSER_PASSWORD=password-seguro-del-admin

# ──────────────────────────────────────────────────────────────
# OpenAI (opcional)
# ──────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ──────────────────────────────────────────────────────────────
# Sentry (opcional — monitoreo de errores)
# https://sentry.io
# ──────────────────────────────────────────────────────────────
SENTRY_DSN=
SENTRY_TRACES_RATE=0.1

# ──────────────────────────────────────────────────────────────
# Gunicorn (ajustar según CPU del servidor)
# ──────────────────────────────────────────────────────────────
GUNICORN_WORKERS=4
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=120
GUNICORN_BIND=0.0.0.0:8000

# ──────────────────────────────────────────────────────────────
# Logs
# ──────────────────────────────────────────────────────────────
LOG_DIR=/app/logs

# ──────────────────────────────────────────────────────────────
# Collectstatic (poner true para skip en entornos CI/CD)
# ──────────────────────────────────────────────────────────────
SKIP_COLLECTSTATIC=false

# ──────────────────────────────────────────────────────────────
# Celery en modo síncrono (solo desarrollo)
# ──────────────────────────────────────────────────────────────
CELERY_ALWAYS_EAGER=false
