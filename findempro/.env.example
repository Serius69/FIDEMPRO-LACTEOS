# ══════════════════════════════════════════════════════════
# FINDEMPRO — Variables de entorno
# Copiar a .env y rellenar los valores reales.
# NUNCA commitear .env con valores reales.
# ══════════════════════════════════════════════════════════

# ── Django ────────────────────────────────────────────────
SECRET_KEY=change-me-in-production
# Valor dev usado por docker-compose.dev.yml (findempro_backend/celery/celery_beat)
DEBUG=True
DJANGO_ENV=production
DJANGO_ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com

# ── Base de datos ─────────────────────────────────────────
DB_ENGINE=django.db.backends.postgresql
DB_NAME=findempro
DB_USER=findempro
DB_PASSWORD=change-me
DB_HOST=findempro_db
DB_PORT=5432

# ── Redis ─────────────────────────────────────────────────
REDIS_URL=redis://findempro_redis:6379/1

# ── Celery ───────────────────────────────────────────────
CELERY_BROKER_URL=redis://findempro_redis:6379/0
CELERY_RESULT_BACKEND=redis://findempro_redis:6379/0

# ── PostgreSQL (usado por el servicio findempro_db) ───────
POSTGRES_DB=findempro
POSTGRES_USER=findempro
POSTGRES_PASSWORD=change-me

# ── Autenticación social ──────────────────────────────────
SOCIAL_AUTH_GOOGLE_OAUTH2_KEY=
SOCIAL_AUTH_GOOGLE_OAUTH2_SECRET=

# ── Email ────────────────────────────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# ── Monitoreo ─────────────────────────────────────────────
SENTRY_DSN=

# ── Seguridad HTTPS (poner true solo con SSL real) ────────
HTTPS_ENABLED=false
CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ── CORS (frontend separado) ──────────────────────────────
CORS_ALLOWED_ORIGINS=https://app.kapitalya.com.bo

# ── Kapitalya Hub SSO ─────────────────────────────────────
# Flujo vigente: el satélite INICIA el login en /hub/login/ (que fija la cookie de
# `state`) y el Hub vuelve SOLO a /hub/callback/ con `?hub_token=…&state=…`.
# El canje suelto de `?hub_token=` en cualquier ruta está retirado.
#
# HUB_JWT_SECRET debe ser IDÉNTICO en todos los proyectos del ecosistema. Sin él,
# /hub/login/ y /hub/callback/ responden 503: el SSO falla cerrado, no abierto.
HUB_JWT_SECRET=
HUB_URL=https://kapitalya.com.bo
# Marca el entorno como desarrollo para hub_auth. Controla SOLO el flag `Secure`
# de las cookies de `state` y de sesión (hub_auth/views.py, hub_auth/middleware.py),
# que en dev sobre HTTP hay que apagar o el navegador descarta la cookie.
# Es independiente de DEBUG de Django. Dejar vacío/False en producción.
DJANGO_DEBUG=False
# El SSO reusa el REDIS_URL de arriba pero cambia la DB por la 2, para guardar la
# redención de un solo uso de `state`/`jti` fuera del churn de la caché de la app.
# Sin Redis alcanzable no se emite sesión (falla cerrado): la DB 2 tiene que existir.

# ── django-axes (fuerza bruta en login) ───────────────────
AXES_ENABLED=True
AXES_FAILURE_LIMIT=5
AXES_COOLOFF_HOURS=1

# ── IA / LLM ──────────────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# ── Sentry (muestreo de trazas) ───────────────────────────
SENTRY_TRACES_RATE=0.1
SENTRY_PROFILES_RATE=0.05

# ── Varios ────────────────────────────────────────────────
SITE_ID=1
DEFAULT_FROM_EMAIL=
DB_CONN_MAX_AGE=600

# ── KDP · Kapitalya Data Platform ─────────────────────────
# Token PROPIO de Findempro (alcance: sólo sus datasets). Sale de
# `kapitalya-data/storage/consumers.dev.env` como KDP_TOKEN_FINDEMPRO.
# Sin token la API responde 401 y el consumidor degrada con la etiqueta puesta.
KDP_API_URL=http://127.0.0.1:8099
KDP_API_TOKEN=
KDP_CONSUMER_ID=Findempro
KDP_DATASET_ID=findempro_sector_bo
KDP_TIMEOUT=20
# Cada cuánto drena el cursor el beat de Celery (segundos).
KDP_CONSUME_INTERVAL_S=600
# Dónde vive el cursor local (por defecto BASE_DIR/var/kdp).
KDP_STATE_DIR=
